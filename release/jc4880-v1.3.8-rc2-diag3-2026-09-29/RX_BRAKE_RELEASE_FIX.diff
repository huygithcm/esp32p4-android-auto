@@ -771 +771,7 @@
-    (set-current (* (- 0.0 rv-rel) (reverse-limit)) 0.2)
+    (let ((cmd (* (- 0.0 rv-rel) (reverse-limit))))
+        ; The optional 0.2 is a FOC modulation-off delay, not a command timeout.
+        ; Refresh it only while reverse torque is actually requested. Repeating
+        ; (set-current 0 0.2) at 100 Hz leaves the power stage active forever.
+        (if (> (abs cmd) 0.001)
+            (set-current cmd 0.2)
+            (set-current 0)))
