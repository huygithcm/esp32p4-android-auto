--- rc2/main.lisp
+++ rc2-diag1/main.lisp
@@ -16,6 +16,12 @@
 (def throttle-on 0)
 (def park-on 1)
 (def safety-fault 0)
+; RC2 diag1: volatile first RECORDED guard; unchanged 100 ms thresholds.
+(def diag-first 0)
+(def diag-at 0)
+(def diag-tx-age 0.0)
+(def diag-rx-age 0.0)
+(def diag-motor-age 0.0)
 (def motor-seen 0)
 (def motor-live 0)
 (def rv-seen 0)
@@ -119,7 +125,21 @@
     (match (trap (conf-get 'adc-ctrl-type))
         ((exit-ok (? value)) (= value 0))
         (_ nil)))
-(if (not (native-input-only)) (setq safety-fault 9))
+; Numeric snapshot only: no I/O, trap or yield inside atomic.
+; Ages describe capture time, after the stop, not exact predicate time.
+(defun diag-mark (code)
+    (atomic
+        (if (= diag-first 0) {
+            (setq diag-at (systime))
+            (setq diag-tx-age (secs-since tx-seen))
+            (setq diag-rx-age (secs-since rv-seen))
+            (setq diag-motor-age (secs-since motor-seen))
+            (setq diag-first code)
+        })))
+(if (not (native-input-only)) {
+    (setq safety-fault 9)
+    (diag-mark 1)
+})
 
 (defun drive-clear () {
     (setq out-rel 0.0) (setq rv-rel 0.0)
@@ -153,6 +173,12 @@
     (setq park-on 1) (setq throttle-on 0)
     (drive-clear)
     (setq rv-dir 0)
+})
+; Preserve the fault latch and stop before any diagnostic capture.
+(defun diag-trip (code) {
+    (ride-input-fault)
+    (set-current 0)
+    (diag-mark code)
 })
