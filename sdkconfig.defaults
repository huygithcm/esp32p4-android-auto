# Baseline for the ESP32-S3 build. Derived from the ESP32-P4 original, which is
# kept verbatim at reference/sdkconfig.defaults.p4 — every P4/ESP-Hosted/H.264
# option there was dropped, everything chip-agnostic was carried over with its
# original comment so the reasoning survives.
#
# Board-specific overlays (flash size, partition table, CAN pins, panel timing)
# belong in sdkconfig.defaults.<board>, not here.

# Target
CONFIG_IDF_TARGET="esp32s3"

# ===== PSRAM =====
# Mandatory: 800x480 RGB565 is 768 KB per framebuffer, and LVGL's heap lives in
# PSRAM too (see LV_MEM_CUSTOM in main/lv_conf.h). Octal at 80 MHz is the only
# configuration with enough bandwidth to feed an RGB panel — quad PSRAM will
# tear. Verify against the actual module: not every S3 board has octal.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MEMTEST=n
# 64-byte data cache line: required for RGB-panel DMA out of PSRAM to keep up.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ===== LVGL =====
# Using main/lv_conf.h. CONFIG_LV_CONF_SKIP=n tells the LVGL package to
# '#include "lv_conf.h"' instead of generating one from Kconfig values; the
# header is found via the global -I${CMAKE_SOURCE_DIR}/main set in the root
# CMakeLists.txt.
CONFIG_LV_CONF_SKIP=n
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_32=y

# BSP — never abort() on init errors. The touch controller occasionally fails
# its first I2C read on cold boot (timing-sensitive); we want the display to
# come up anyway and the caller to handle the error.
CONFIG_BSP_ERROR_CHECK=n

# ===== WiFi (native on S3 — no ESP-Hosted, no co-processor) =====
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BUFFER_TYPE=0
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
# Wi-Fi and BLE share one radio on S3/ESP32 (the P4 had a separate C6 for
# each). Software coexistence must be on or BLE links drop whenever the AP
# has traffic.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ===== VESC CAN pins =====
# PLACEHOLDER — must be set per board. On an S3 with a 16-bit RGB panel plus
# octal PSRAM there are very few free GPIOs left; pick two that the panel does
# not claim and pin them here so a fresh sdkconfig regeneration cannot silently
# move them.
CONFIG_VESC_CAN_TX_GPIO=43
CONFIG_VESC_CAN_RX_GPIO=44

# Enable LISP stats poll — required for cruise-control indicator, cruise
# speed text and current-profile (mode) label. The Super_VESC_Display Lisp
# script (main.lisp) publishes `cruise-active`, `cruise-rpm`, `rpm-per-ms`
# and `current-profile`; vesc_ui_updater.c::push_cruise_locked() reads them
# from vesc_lisp_poll and pushes to the dashboard. Off in Kconfig default
# because not every VESC has a Lisp app loaded; this firmware assumes one.
CONFIG_VESC_CAN_LISP_POLL_ENABLE=y

# lwIP
CONFIG_LWIP_MAX_SOCKETS=10

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ===== Flash + partitions =====
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_s3_16mb.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_s3_16mb.csv"
# NVS-erase render stalls are mitigated by debounced/deferred nvs_commit() off
# the LVGL thread, not by flash suspend.
CONFIG_SPI_FLASH_AUTO_SUSPEND=n

# ===== Console UART baud =====
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_ESPTOOLPY_MONITOR_BAUD=921600

# ===== Bluetooth (NimBLE on the native S3 controller) =====
# The P4 build ran the NimBLE host over ESP-Hosted's virtual HCI because the
# P4 has no radio. Here the controller is on-chip, so CONFIG_BT_CONTROLLER_*
# stays at its default (enabled) and no transport option is needed.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
# NimBLE host allocations from PSRAM, not the cramped internal pool. Note this
# covers the HOST only — the controller's own buffers must stay in internal
# DMA-capable RAM, which is the tightest single constraint on S3.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# Dual-role: we advertise a GATT server (peripheral, for the phone) AND act
# as a central/GATT-client to connect to an external BLE cadence sensor for
# the pedal-assist (PAS) feature and to the JK BMS — scan (OBSERVER) +
# connect (CENTRAL) + service discovery / subscribe (GATT_CLIENT).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
# 512 B ATT MTU (NimBLE's own default is 256). VESC Tool already asks for 512
# and the companion app now does too, so a ~415 B framed LISP READ reply rides
# in ONE notification instead of two — one fewer connection event per chunk on
# a path that is pure round-trip latency. Notifications are chained out of the
# msys pool, so the block count goes up with the MTU: at 256 B/block a 512 B
# PDU takes 2-3 blocks, and the stock 12 empty out mid-burst → BLE_HS_ENOMEM,
# which ble_nus.c can only answer with a 5 ms backoff.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24

# LVGL image decoder (esp_lv_decoder): registers a global LVGL image decoder
# that sniffs in-memory PNG/JPEG sources by magic bytes. Needed so the
# notification toast can render the 72x72 PNG app icons the phone pushes over
# BLE — without it lv_img gets raw PNG bytes it can't decode and falls back to
# the blue letter tile.
CONFIG_ESP_LVGL_ADAPTER_ENABLE_DECODER=y

# FAT long filenames on the microSD card. IDF defaults FATFS to 8.3 short
# names, so a file like "my recording 2024.mp4" shows up mangled and long-named
# files can't be created — both the on-device file browser and the BLE file
# manager hit this on /sdcard. Heap-backed LFN buffer (STACK would put ~1 KB on
# whatever task runs FAT ops and risk the ble_files / files_screen worker
# stacks); UTF-8 API so non-ASCII names round-trip with the phone.
# /vescfs (LittleFS) already supports long names, so this is FAT-only.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
