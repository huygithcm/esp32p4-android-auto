+def function(source, name):
+    match = re.search(r'^(?:static )?(?:void|esp_err_t) ' + name + r'\([^;]*?\)\s*\{', source, re.M)
+    if not match:
+        raise ValueError(f'Function not found: {name}')
+    start = match.start()
+    depth = 1
+    i = match.end()
+    while depth:
+        if source[i] == '{':
+            depth += 1
+        elif source[i] == '}':
+            depth -= 1
+        i += 1
+    return source[start:i]
