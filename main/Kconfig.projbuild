menu "VESC Display Head Unit"

    choice BOARD_MODEL
        prompt "Target hardware board"
        default BOARD_S3_RGB_800X480
        help
            Selects the physical head-unit board. Drives board-specific GPIO
            pins (LCD backlight/reset, panel timing, touch) that can't be
            expressed through plain Kconfig — see the CONFIG_BOARD_* #if
            branches in whichever components/bsp_board implementation is
            active.

            This choice alone does NOT set flash size / partition table / CAN
            pins; those live in the per-board sdkconfig.defaults.<board>
            overlay. Keep them in lockstep with this choice.

            PLACEHOLDER: these three entries are the targets from
            docs/ESP32_S3_PORT_PLAN.md. Rename / replace them once the actual
            panels are pinned down — no BSP implements any of them yet.

        config BOARD_S3_RGB_800X480
            bool "ESP32-S3 + 800x480 RGB panel (4.3\" / 7\")"

        config BOARD_S3_SMALL
            bool "ESP32-S3 + small SPI/QSPI panel (2.8\")"

        config BOARD_ESP32_SMALL
            bool "ESP32 (classic) + small SPI panel (2.8\")"
    endchoice

    choice WIFI_ROLE
        prompt "WiFi role"
        default WIFI_ROLE_AP
        help
            AP: the head unit runs its own SoftAP and you join it to reach the
            web UI (/files, /lisp) and HTTP OTA. STA: join an existing network
            instead — handy on the bench.

        config WIFI_ROLE_AP
            bool "SoftAP"

        config WIFI_ROLE_STA
            bool "Station — connect to existing WiFi"
    endchoice

    config WIFI_AP_SSID_PREFIX
        string "AP SSID prefix"
        depends on WIFI_ROLE_AP
        default "VESC"
        help
            Last 4 hex digits of the MAC are appended, e.g. "VESC-1A2B".

    config WIFI_AP_PASSWORD
        string "AP password (WPA2-PSK, min 8 chars)"
        depends on WIFI_ROLE_AP
        default "12345678"

    config WIFI_AP_CHANNEL
        int "AP channel (1-13)"
        depends on WIFI_ROLE_AP
        default 6
        range 1 13

    config WIFI_STA_SSID
        string "Bench WiFi SSID"
        depends on WIFI_ROLE_STA
        default "myssid"

    config WIFI_STA_PASSWORD
        string "Bench WiFi password"
        depends on WIFI_ROLE_STA
        default "mypassword"

    config WIFI_STA_MAX_RETRY
        int "Maximum STA connect retries"
        depends on WIFI_ROLE_STA
        default 10

    menu "OTA over WiFi"

        config OTA_HTTP_ENABLED
            bool "Enable HTTP OTA server"
            default y
            help
                Starts a small HTTP server (default port 80) after WiFi is up.
                POST the new app binary to /ota and the device will flash the
                inactive OTA slot and reboot. See scripts/ota_push.sh.

        config OTA_HTTP_PORT
            int "OTA HTTP port"
            depends on OTA_HTTP_ENABLED
            default 80
            range 1 65535

        config LISP_HTTP_ENABLED
            bool "Web LISP editor (/lisp)"
            depends on OTA_HTTP_ENABLED
            default y
            help
                Attaches a full LispBM editor to the same HTTP server:
                syntax highlighting, linting, the on-device script library
                under /vescfs/lisp, read/upload/run against the VESC over
                CAN, live (print ...) console and a REPL line.

                Costs roughly 20 KiB of flash for the gzipped page.

    endmenu

    config DEBUG_UART_BRIDGE
        bool "UART0 debug bridge (screenshot + touch injection)"
        default n
        help
            Registers esp_console commands on the UART0 console for host-driven
            UI test automation (scripts/uart_debug.py): screenshot, tap, swipe,
            touchdown/up/move.

            NOT BUILDABLE YET on this branch — main/debug_uart_bridge.c is
            commented out of main/CMakeLists.txt because its screenshot path
            uses the ESP32-P4 hardware JPEG encoder, which neither S3 nor ESP32
            has. The raw RGB565 path in the same file needs no encoder.

            Costs flash and ~1 MB PSRAM (lazily allocated on first screenshot).
            Also forces LV_USE_SNAPSHOT on. Leave OFF for production builds.

    config DEBUG_UART_BRIDGE_JPEG_QUALITY
        int "Default screenshot JPEG quality (1-100)"
        depends on DEBUG_UART_BRIDGE
        default 80
        range 1 100

endmenu
